{
  "name": "bark-proxy",
  "description": "The proxy server behind the bark Browser",
  "keywords": [
    "proxy",
    "wisp",
    "scramjet",
    "ultraviolet"
  ],
  "env": {
    "GOOGLE_CLIENT_ID": {
      "description": "Google OAuth client ID (Web application)",
      "required": true
    },
    "GOOGLE_CLIENT_SECRET": {
      "description": "Google OAuth client secret",
      "required": true
    },
    "SESSION_SECRET": {
      "description": "Any long random string",
      "generator": "secret"
    }
  },
  "image": "heroku/nodejs"
}
